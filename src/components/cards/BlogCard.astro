---
import type { BlogPost } from '@/types/wordpress';
import { formatDate } from '@/utils/format';
import { cn } from '@/lib/utils';

export interface Props {
  post: BlogPost;
  loading?: 'eager' | 'lazy';
  /** Wide two-column variant used at the end of the newsfeed grid. */
  wide?: boolean;
}

const { post, loading = 'lazy', wide = false } = Astro.props;

// A post with no REDI-authored article (externalUrl set) links straight to
// that URL in a new tab instead of the internal /updates/[slug] page — see
// BlogPost.externalUrl and getAllBlogSlugs() in src/services/wordpress/blog.ts.
const isExternal = Boolean(post.externalUrl);
const href = post.externalUrl ?? `/updates/${post.slug}`;
---

{
  /*
  flex column + h-full so every card fills its grid cell. Titles run to one,
  two or three lines, and without this each card shrank to its own content and
  the row came out ragged. The image keeps its fixed aspect ratio and the text
  block takes the slack, so the cards line up whatever the headline length.
  Both callers put this in a grid, so there is always a cell to fill.
*/
}
<article
  class="group bg-steel-200 shadow-soft hover:shadow-lifted relative flex h-full flex-col overflow-hidden rounded-xl transition-all duration-300 ease-out hover:-translate-y-1.5"
>
  <a
    href={href}
    class="absolute inset-0 z-10"
    aria-label={post.title}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}></a>
  <div class={cn('shrink-0 overflow-hidden', wide ? 'aspect-[1527/655]' : 'aspect-[998/655]')}>
    <img
      src={post.featuredImage.url}
      alt={post.featuredImage.alt}
      width="998"
      height="655"
      loading={loading}
      decoding="async"
      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col px-4 pt-3.5 pb-4">
    <p class="text-navy-700 text-sm font-semibold">{post.tags.join(', ')}</p>
    <p class="mt-0.5 flex items-center gap-2 text-sm text-slate-600">
      {
        post.date && (
          <>
            <time datetime={post.date}>{formatDate(post.date)}</time>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <span>{post.author.name}</span>
    </p>
    <h3
      class="font-heading text-ink-800 group-hover:text-navy-700 mt-1 text-base font-bold tracking-normal transition-colors"
    >
      {post.title}
    </h3>
  </div>
</article>
