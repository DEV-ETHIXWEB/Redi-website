---
import type { TeamMember } from '@/types/wordpress';
import LinkedInIcon from '@/components/ui/LinkedInIcon.astro';

export interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article
  class="group bg-steel-200 shadow-soft hover:shadow-lifted flex h-full flex-col overflow-hidden rounded-xl transition-all duration-300 ease-out hover:-translate-y-1.5"
>
  {
    /*
      Square, because every supplied headshot is square (1600x1600, 1254x1254,
      1200x1159). The old 998/690 landscape window showed only 69% of the photo
      height, so a tightly-cropped headshot lost its chin and the head filled
      the frame: Taylor's took 90% of the card and Darin's 100%, against 51%
      for the wider-framed shots. The client asked why those two looked so
      large. Matching the frame to the source shows the whole photo, so how a
      face sits in the card is now decided by the photo rather than by a crop.
    */
  }
  <div class="aspect-square overflow-hidden">
    <img
      src={member.photo.url}
      alt={member.photo.alt}
      width="998"
      height="690"
      loading="lazy"
      decoding="async"
      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      style={`object-position: ${member.photoPosition ?? 'center'};`}
    />
  </div>
  <div class="px-4 pt-3 pb-3.5">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="text-sm text-slate-600">{member.jobTitle}</p>
        <h3 class="font-heading text-ink-800 text-base font-bold tracking-normal">
          {member.name}
        </h3>
      </div>
      {
        member.linkedIn && (
          <a
            href={member.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${member.name} on LinkedIn`}
            class="text-ink-600 hover:text-navy-700 mt-0.5 shrink-0 transition-colors"
          >
            <LinkedInIcon size={18} />
          </a>
        )
      }
    </div>
    {
      member.quote && (
        <blockquote class="text-ink-600 mt-3 text-[13.5px] leading-relaxed italic">
          “{member.quote}”
        </blockquote>
      )
    }
    {
      /*
        Contact details for the people a visitor is meant to reach directly.
        Rendered only when present, so board members (who have none) are
        unchanged. The phone number keeps its display formatting while `href`
        strips everything but the digits, which is what tel: expects.
      */
    }
    {
      (member.email || member.phone) && (
        <ul class="mt-3 space-y-1 text-[13.5px] leading-relaxed">
          {member.email && (
            <li>
              <a
                href={`mailto:${member.email}`}
                class="text-navy-700 font-semibold break-all transition-colors hover:text-cyan-600"
              >
                {member.email}
              </a>
            </li>
          )}
          {member.phone && (
            <li>
              <a
                href={`tel:${member.phone.replace(/[^\d+]/g, '')}`}
                class="text-navy-700 font-semibold transition-colors hover:text-cyan-600"
              >
                {member.phone}
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</article>
