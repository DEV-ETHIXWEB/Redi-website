---
import type { ScoreTier } from '@/types/wordpress';

export interface Props {
  tier: ScoreTier;
}

const { tier } = Astro.props;
---

<article
  class="bg-steel-200 shadow-soft hover:shadow-lifted flex h-full flex-col items-center rounded-xl px-4 py-8 text-center transition-all duration-300 ease-out hover:-translate-y-1.5"
>
  <div class="flex h-[104px] items-center justify-center">
    <img
      src={tier.badgeImage.url}
      alt={tier.badgeImage.alt}
      height="160"
      loading="lazy"
      decoding="async"
      class="max-h-full w-auto"
    />
  </div>
  {
    /* Score range in high-contrast navy so it is legible on the light card
      (WCAG 1.4.3); tier identity/color is carried by the badge mark above. */
  }
  <p class="font-display text-navy-950 mt-4 text-xl tracking-wide">
    {tier.range}
  </p>
  <p class="text-ink-600 mt-3 text-sm leading-relaxed">{tier.description}</p>
</article>
