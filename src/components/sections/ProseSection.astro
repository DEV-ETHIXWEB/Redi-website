---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { cn } from '@/lib/utils';
import { heroSrcSet } from '@/utils/responsive-image';

/**
 * Eyebrow + heading + flowing paragraphs, optionally with a side image
 * (`imageSide`) or full-width text. Used for Mission, Business Model, etc.
 */
export interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];
  image?: { url: string; alt: string };
  imageSide?: 'left' | 'right';
  /**
   * Intrinsic ratio of the image box. The default is the wide 1026x550 crop
   * most section images use; pass the photo's own ratio when cropping to that
   * would cut the subject - a group photo being the obvious case, where
   * `object-cover` would take the crop out of people's heads.
   */
  imageAspect?: { width: number; height: number };
  headingAlign?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  heading,
  paragraphs,
  image,
  imageSide = 'right',
  imageAspect = { width: 1026, height: 550 },
  headingAlign = 'left',
  class: className,
} = Astro.props;
---

<section class={cn('bg-steel-100 py-14 sm:py-20 md:py-24', className)}>
  <div class="container-page">
    <SectionHeading eyebrow={eyebrow} heading={heading} align={headingAlign} />
    {
      image ? (
        <div class="reveal mt-10 grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div
            class={cn(
              'text-ink-600 space-y-6 text-[15px] leading-relaxed sm:text-base',
              imageSide === 'left' && 'lg:order-2',
            )}
          >
            {paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <div
            class={cn(
              'shadow-card overflow-hidden rounded-xl',
              imageSide === 'left' && 'lg:order-1',
            )}
          >
            <img
              src={image.url}
              srcset={heroSrcSet(image.url)}
              sizes="(min-width: 1280px) 1232px, 100vw"
              alt={image.alt}
              width={imageAspect.width}
              height={imageAspect.height}
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
          </div>
        </div>
      ) : (
        <div class="text-ink-600 reveal mt-8 max-w-[1030px] space-y-6 text-[15px] leading-relaxed sm:text-base">
          {paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      )
    }
    <slot />
  </div>
</section>
