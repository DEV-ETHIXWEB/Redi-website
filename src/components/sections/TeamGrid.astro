---
import type { TeamMember } from '@/types/wordpress';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamCard from '@/components/cards/TeamCard.astro';

export interface Props {
  eyebrow: string;
  heading: string;
  members: TeamMember[];
}

const { eyebrow, heading, members } = Astro.props;

// WordPress can legitimately return zero team members. Skip the whole
// section rather than show a heading over an empty grid.
const hasMembers = members.length > 0;
---

{
  hasMembers && (
    <section class="bg-steel-100 py-14 sm:py-20 md:py-24">
      <div class="container-page">
        <SectionHeading eyebrow={eyebrow} heading={heading} align="center" />

        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {members.map((member, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 70}ms`}>
              <TeamCard member={member} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
