---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { getScoringCriteria, getCoreDocuments, getPageCopy } from '@/services/wordpress';

const [criteria, documents, copy] = await Promise.all([
  getScoringCriteria(),
  getCoreDocuments(),
  getPageCopy(),
]);
const c = copy.approach.criteria;
const SCORING_SCALE_PDF = '/downloads/redi-scoring-scale.pdf';
---

<section class="bg-steel-100 py-14 sm:py-20 md:py-24">
  <div class="container-page">
    <SectionHeading eyebrow={c.eyebrow} heading={c.heading} body={c.body} />

    <div class="mt-10 grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="text-ink-600 text-[15px] leading-relaxed sm:text-base">
        <p>{c.primaryLabel}</p>
        <ul class="mt-2 list-disc space-y-1 pl-6">
          {criteria.primaryCriteria.map((item) => <li>{item}</li>)}
        </ul>
        <p class="font-heading text-ink-800 mt-8 text-sm font-bold tracking-wide uppercase">
          {c.eligibleLabel}
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-6">
          {criteria.eligibility.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <figure class="shadow-card overflow-hidden rounded-xl bg-white">
        <img
          src="/images/sections/scoring-weights.webp"
          alt="Scoring Weights chart: Utilities 30%, Ownership & Entitlements 20%, Environmental 20%, Ease of Development 15%, Logistics 15%"
          width="1482"
          height="1496"
          loading="lazy"
          decoding="async"
          class="w-full"
        />
      </figure>
    </div>

    <div class="mt-16">
      <p class="font-heading text-ink-900 text-xl font-bold tracking-tight sm:text-2xl">
        {c.documentsLabel}
      </p>
      <p class="text-ink-600 mt-2 max-w-[760px] text-[15px] leading-relaxed sm:text-base">
        {c.documentsIntro}
      </p>
      <div
        class="shadow-card mt-6 overflow-x-auto rounded-xl bg-white"
        tabindex="0"
        role="region"
        aria-label={c.documentsLabel}
      >
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-steel-300 border-b">
              <th
                class="font-heading text-ink-700 px-5 py-3 text-xs font-bold tracking-wide uppercase"
                >Readiness Area</th
              >
              <th
                class="font-heading text-ink-700 px-5 py-3 text-xs font-bold tracking-wide uppercase"
                >What to Submit</th
              >
            </tr>
          </thead>
          <tbody>
            {
              documents.map((doc, index) => (
                <tr class={index < documents.length - 1 ? 'border-steel-200 border-b' : ''}>
                  <td class="text-ink-900 px-5 py-3.5 align-top font-semibold whitespace-nowrap">
                    {doc.area}
                  </td>
                  <td class="text-ink-600 px-5 py-3.5 align-top leading-relaxed">{doc.submit}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-ink-600 mt-4 max-w-[760px] text-sm leading-relaxed">{c.documentsFootnote}</p>
    </div>

    {
      /*
        The button downloads the PDF directly.

        It used to expand a Monday.com lead-capture form in place, and the PDF
        was only reachable from an "Already filled this out?" link underneath
        it. That meant a visitor who pressed a button labelled "Download
        Scoring Scale" got a form instead of a download, and the escape hatch
        only appeared once they had scrolled past the whole form — so the
        quickest way to the file was to ignore the button they had just
        pressed. The file is public at SCORING_SCALE_PDF either way, so the
        form was not actually gating anything.

        Note this removes a lead-capture step the client set up. If they want
        it back, the right shape is a form that delivers the file on submit,
        not a button that promises a download and opens a form.
      */
    }
    <div class="shadow-card mt-16 rounded-2xl bg-white p-8 text-center sm:p-10" data-scoring-scale>
      <p class="font-heading text-ink-900 text-xl font-bold tracking-tight sm:text-2xl">
        {c.downloadFormHeading}
      </p>
      <p class="text-ink-600 mx-auto mt-2 max-w-[520px] text-[15px] leading-relaxed">
        {c.downloadFormBody}
      </p>
      <Button variant="primary" icon="download" class="mt-6" href={SCORING_SCALE_PDF} download>
        {c.downloadLabel}
      </Button>
    </div>
  </div>
</section>
