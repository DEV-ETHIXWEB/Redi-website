---
import Icon from '@/components/ui/Icon.astro';

/**
 * Official Monday.com contact form embed. Vendor snippet ships a fixed
 * 650x500 iframe with its own inline box-shadow — dropped in favor of a
 * fluid, centered container sized in REDI's own shadow/radius tokens so it
 * reads as part of the site rather than a foreign widget.
 *
 * `formId` is required (no default) so every caller must be explicit about
 * which Monday.com form it wants — register.astro and contact.astro use two
 * different forms, and a shared default previously caused both pages to
 * silently render the same (Register) form.
 *
 * Monday's own form markup isn't responsive below ~650px — embedded at any
 * narrower width it clips (fixed size) rather than reflowing. Since the form
 * must stay inline (no horizontal scroll, no "open elsewhere" redirect), the
 * iframe renders at Monday's native 650xNATIVE_HEIGHT and is scaled down as
 * a whole (`transform: scale()`, computed client-side from the actual
 * available width) to fit narrower screens — shrinking uniformly rather than
 * clipping. Text gets smaller on narrow phones as a result; that's the
 * accepted trade-off for keeping the whole form visible in place. Desktop/
 * tablet (>=650px available) computes a scale of 1, i.e. renders at native
 * size, unchanged from before.
 *
 * NATIVE_HEIGHT has to be a guess, not a measurement: forms.monday.com is a
 * different origin, so same-origin policy blocks reading the iframe's real
 * content height from here. Deliberately overshoot — the failure mode of
 * guessing too tall is empty space at the bottom of a short form; guessing
 * too short silently crops off whatever's below the cutoff (fields, even the
 * submit button) with no way to reach it, which is much worse.
 */
export interface Props {
  formId: string;
}

const { formId } = Astro.props;
const MONDAY_FORM_SRC = `https://forms.monday.com/forms/embed/${formId}?r=use1`;
const NATIVE_WIDTH = 650;
const NATIVE_HEIGHT = 1500;
---

<div class="mx-auto w-full max-w-[650px]">
  <div
    class="shadow-lifted bg-steel-100 relative w-full overflow-hidden rounded-xl"
    style={`height: ${NATIVE_HEIGHT}px;`}
    data-monday-wrapper
  >
    <div
      class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-inherit transition-opacity duration-300 ease-out"
      data-monday-loader
    >
      <span data-monday-spinner>
        <Icon name="loader-circle" size={32} class="animate-spin text-cyan-500" />
      </span>
      <p
        class="font-heading text-ink-600 px-6 text-center text-xs font-semibold tracking-wide uppercase"
        data-monday-status
      >
        Loading contact form…
      </p>
      <a
        href={MONDAY_FORM_SRC}
        target="_blank"
        rel="noopener noreferrer"
        class="font-heading shadow-soft hover:shadow-card text-navy-950 hidden h-[40px] items-center justify-center rounded-lg bg-cyan-400 px-5 text-xs font-semibold tracking-wide uppercase transition-all duration-200 hover:bg-cyan-300"
        data-monday-fallback-link
      >
        Open form in a new tab
      </a>
    </div>
    <iframe
      src={MONDAY_FORM_SRC}
      title="REDI Sites contact form"
      loading="lazy"
      width={NATIVE_WIDTH}
      height={NATIVE_HEIGHT}
      class="absolute top-0 left-0 origin-top-left border-0"
      data-monday-frame
    >
    </iframe>
  </div>
</div>

<noscript>
  <style>
    [data-monday-loader] {
      display: none;
    }
  </style>
</noscript>

<script is:inline define:vars={{ NATIVE_WIDTH, NATIVE_HEIGHT }}>
  function initMondayForm() {
    // querySelectorAll, not querySelector: a page may hold more than one embed
    // (and the scoring-scale one sits inside a collapsed container), so binding
    // only the first would leave the others spinning forever.
    document.querySelectorAll('[data-monday-wrapper]').forEach(setupMondayForm);
  }

  function setupMondayForm(wrapper) {
    const frame = wrapper.querySelector('[data-monday-frame]');
    const loader = wrapper.querySelector('[data-monday-loader]');
    const spinner = wrapper.querySelector('[data-monday-spinner]');
    const status = wrapper.querySelector('[data-monday-status]');
    const fallbackLink = wrapper.querySelector('[data-monday-fallback-link]');
    if (!frame || !loader || frame.dataset.bound === 'true') return;
    frame.dataset.bound = 'true';

    const applyScale = () => {
      const scale = Math.min(1, wrapper.clientWidth / NATIVE_WIDTH);
      frame.style.transform = `scale(${scale})`;
      wrapper.style.height = `${NATIVE_HEIGHT * scale}px`;
    };

    applyScale();
    window.addEventListener('resize', applyScale);

    // Vendor form is a cross-origin SPA — `load` fires once the iframe's
    // document has parsed, which is the best signal available (Monday.com
    // has no postMessage API telling us when the form itself has painted).
    let settled = false;
    let stuck = false;
    let stuckTimer = null;

    const hide = () => {
      if (settled) return;
      settled = true;
      clearTimeout(stuckTimer);
      if (stuck) {
        // Late success after the fallback already showed — undo the
        // collapse and restore the real form instead of leaving the
        // visitor looking at an empty box under a "loading" message.
        frame.style.display = '';
        window.addEventListener('resize', applyScale);
        applyScale();
      }
      loader.classList.add('opacity-0');
      loader.addEventListener('transitionend', () => loader.remove(), { once: true });
    };

    // If the embed hasn't loaded after a generous window (blocked by a
    // firewall/ad-blocker, vendor outage, slow network), stop spinning
    // forever and hand the visitor a working way out instead. Also collapse
    // the wrapper from its tall NATIVE_HEIGHT guess down to a compact card —
    // otherwise the fallback message sits stranded in the middle of a mostly
    // empty 1500px box the visitor has to scroll through to find.
    const giveUp = () => {
      if (settled) return;
      stuck = true;
      spinner?.remove();
      if (status) status.textContent = 'This is taking longer than expected.';
      fallbackLink?.classList.remove('hidden');
      window.removeEventListener('resize', applyScale);
      frame.style.display = 'none';
      wrapper.style.height = '220px';
    };

    /**
     * Arm the timeout only once the embed is actually on screen.
     *
     * This used to start counting the moment the page loaded, which broke the
     * scoring-scale form on /approach: that embed lives inside a container
     * that stays collapsed until the visitor clicks "Download Scoring Scale".
     * Anyone who clicked more than 12 seconds after the page loaded — i.e.
     * anyone who read the page first — was shown "This is taking longer than
     * expected" instantly, before the form had been given any chance at all.
     *
     * A hidden element never intersects the viewport, so IntersectionObserver
     * is also what makes `loading="lazy"` honest here: the iframe only starts
     * fetching once it is revealed, and the clock starts at that same moment.
     * Re-running applyScale() on reveal matters too, because clientWidth is 0
     * while the container is collapsed.
     */
    const start = () => {
      if (stuckTimer !== null || settled) return;
      applyScale();
      stuckTimer = setTimeout(giveUp, 12000);
    };

    if (typeof IntersectionObserver === 'function') {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          start();
        },
        { rootMargin: '200px' },
      );
      observer.observe(wrapper);
    } else {
      start();
    }

    frame.addEventListener('load', hide, { once: true });
  }

  initMondayForm();
  document.addEventListener('astro:page-load', initMondayForm);
</script>
