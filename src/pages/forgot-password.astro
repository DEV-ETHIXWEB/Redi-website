---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
---

<BaseLayout
  title="Forgot Password — REDI Sites"
  description="Reset the password for your REDI Sites account."
  noindex
>
  <section class="bg-steel-100 pt-32 pb-24">
    <div class="container-page">
      <div
        class="bg-steel-200/70 shadow-lifted relative mx-auto max-w-[580px] rounded-3xl px-6 py-8 sm:px-12 sm:py-10"
      >
        <a
          href="/sign-in"
          class="text-ink-600 hover:text-ink-900 absolute top-6 right-6 transition-colors sm:top-8 sm:right-8"
          aria-label="Close and return to sign in"
        >
          <Icon name="x" size={22} />
        </a>
        <Logo variant="nav" class="mx-auto" />

        <a
          href="/sign-in"
          class="font-heading text-ink-700 hover:text-ink-900 mt-8 inline-flex items-center gap-1 text-sm font-bold tracking-wide uppercase transition-colors"
        >
          <Icon name="chevron-left" size={16} />
          Back
        </a>
        <h1 class="mt-1 text-4xl sm:text-[2.75rem]">Forgot Password</h1>

        <!--
          The member portal backend is still being connected; this form routes to contact.

          TODO(auth): wire this up to a real Forgot Password API once the
          backend exists.
            1. Expected request:  POST /api/auth/forgot-password  { email }
            2. Expected response: always 200 with a generic success message
               ("If an account exists for that email, a reset link has been
               sent") REGARDLESS of whether the email matches an account —
               returning a different response for known-vs-unknown emails is
               a user-enumeration vulnerability. Do not "improve" this by
               reporting whether the email was found.
            3. Backend should rate-limit this endpoint (e.g. WordPress-side or
               at the edge) to prevent abuse/enumeration-by-timing and email
               bombing of a single address.
            4. The emailed reset link should point to
               `/set-password?token=<reset-token>` — see the TODO in
               SetPasswordForm.tsx for how that token is expected to be
               consumed on the receiving end.
            5. Add a loading state + success/error UI once this is real (reuse
               the status-state-machine pattern from SetPasswordForm.tsx).
        -->
        <form method="get" action="/contact" class="mt-7">
          <label
            class="font-heading text-ink-900 block text-base font-bold tracking-wide uppercase"
          >
            Email
            <input
              type="email"
              name="email"
              class="font-body text-ink-900 mt-2 block h-14 w-full rounded-2xl border-0 bg-white px-6 text-lg font-normal normal-case shadow-sm focus:ring-2 focus:ring-cyan-400 focus:outline-none"
            />
          </label>

          <button
            type="submit"
            class="font-heading text-navy-950 shadow-soft hover:shadow-card mt-8 block h-[58px] w-full rounded-2xl bg-cyan-400 text-xl font-semibold tracking-wide uppercase transition-all duration-200 hover:-translate-y-0.5 hover:bg-cyan-300"
          >
            Send Reset Email
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
