---
export const prerender = false;

import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SitesBrowser from '@/components/sections/SitesBrowser.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Icon from '@/components/ui/Icon.astro';
import { getPageCopy } from '@/services/wordpress';
import { isRateLimited } from '@/lib/rate-limit';

const copy = await getPageCopy();
const sites = copy.sites;
const FIND_A_SITE_SELECTOR_URL =
  'https://siteselectorsguild.com/site-selection/find-a-site-selector/';

/**
 * Basic-info gate for the site listing/property view — not a password, not
 * an account. Visitors give their name, email, and reason for browsing;
 * submitting sets a cookie that remembers they've already done so. No
 * secret, nothing to configure per environment.
 */
const COOKIE_NAME = 'redi_sites_info_access';

interface FieldErrors {
  name?: string;
  email?: string;
  reason?: string;
}

let gateError: string | null = null;
let fieldErrors: FieldErrors = {};
let submittedValues = { name: '', email: '', reason: '' };

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

if (Astro.request.method === 'POST') {
  // CSRF mitigation: reject a cross-origin POST outright. The Origin header
  // is reliably sent by browsers on cross-site form submissions (which is
  // exactly what CSRF relies on) and isn't spoofable by an attacker's page —
  // only same-origin submissions (Origin absent or matching) proceed.
  const origin = Astro.request.headers.get('origin');
  const isCrossOrigin = origin !== null && origin !== Astro.url.origin;

  // 5 submissions/minute per IP — keeps the form from being spammed by a
  // script without needing a database. See src/lib/rate-limit.ts.
  if (isCrossOrigin || isRateLimited(Astro.clientAddress ?? 'unknown')) {
    gateError = isCrossOrigin
      ? 'Request could not be verified. Please try again.'
      : 'Too many attempts. Please wait a minute and try again.';
  } else {
    const form = await Astro.request.formData();
    const name = String(form.get('name') ?? '').trim();
    const email = String(form.get('email') ?? '').trim();
    const reason = String(form.get('reason') ?? '').trim();
    submittedValues = { name, email, reason };

    if (!name) fieldErrors.name = 'Enter your name.';
    if (!email) fieldErrors.email = 'Enter your email.';
    else if (!EMAIL_RE.test(email)) fieldErrors.email = 'Enter a valid email.';
    if (!reason) fieldErrors.reason = 'Let us know why you’re browsing.';

    if (Object.keys(fieldErrors).length === 0) {
      Astro.cookies.set(COOKIE_NAME, '1', {
        path: '/',
        httpOnly: true,
        secure: import.meta.env.PROD,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 30, // 30 days
      });
      return Astro.redirect('/sites');
    }
  }
}

const unlocked = Astro.cookies.get(COOKIE_NAME)?.value === '1';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sites',
      item: new URL('/sites', Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title="Sites - REDI Sites"
  description="Browse thousands of certified commercial development sites across the United States, evaluated for readiness by the Site Selectors Guild."
  structuredData={[breadcrumbLd]}
  preloadImages={['/images/hero/locations-hero-bg.webp']}
>
  <PageHero
    kicker={sites.hero.kicker}
    heading={sites.hero.heading}
    backgroundImage="/images/hero/locations-hero-bg.webp"
  />
  {
    unlocked ? (
      <>
        <CtaBanner
          heading={sites.guidanceCta.heading}
          body={sites.guidanceCta.body}
          ctaLabel={sites.guidanceCta.ctaLabel}
          ctaHref={FIND_A_SITE_SELECTOR_URL}
          backgroundImage="/images/hero/cta-guidance-bg.webp"
        />
        <SitesBrowser />
      </>
    ) : (
      <section class="bg-steel-100 py-16 md:py-20">
        <div class="container-page">
          <div class="shadow-card mx-auto max-w-[480px] rounded-2xl bg-white p-8 sm:p-10">
            <div class="bg-navy-950 mx-auto flex size-12 items-center justify-center rounded-full">
              <Icon name="id-card" size={22} class="text-cyan-400" />
            </div>
            <h2 class="font-heading text-navy-950 mt-5 text-center text-2xl font-bold tracking-tight uppercase">
              Before You Browse
            </h2>
            <p class="text-ink-600 mt-2 text-center text-sm leading-relaxed">
              Tell us a little about yourself to view the site listings. No account, just a quick
              intro.
            </p>
            {/*
                data-astro-reload: BaseLayout's site-wide <ClientRouter />
                (View Transitions) intercepts same-origin form submissions
                and sends them as a client-side fetch instead of a full page
                navigation. This form's POST response sets an httpOnly
                cookie and issues a redirect — both need a real full-page
                navigation to take effect the way the browser (and this
                page's cookie-based unlock check on next load) expects.
              */}
            <form method="POST" class="mt-6 space-y-4" data-astro-reload>
              <div>
                <label
                  for="sites-gate-name"
                  class="font-heading text-ink-700 mb-1.5 block text-xs font-semibold tracking-wide uppercase"
                >
                  Name
                </label>
                <input
                  id="sites-gate-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  autofocus
                  value={submittedValues.name}
                  aria-invalid={Boolean(fieldErrors.name)}
                  class="border-steel-300 w-full rounded-lg border bg-white px-4 py-2.5 text-base outline-none focus:border-cyan-500 focus:ring-[3px] focus:ring-cyan-400/30"
                />
                {fieldErrors.name && (
                  <p class="mt-1.5 text-xs font-medium text-red-600" role="alert">
                    {fieldErrors.name}
                  </p>
                )}
              </div>
              <div>
                <label
                  for="sites-gate-email"
                  class="font-heading text-ink-700 mb-1.5 block text-xs font-semibold tracking-wide uppercase"
                >
                  Email
                </label>
                <input
                  id="sites-gate-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  value={submittedValues.email}
                  aria-invalid={Boolean(fieldErrors.email)}
                  class="border-steel-300 w-full rounded-lg border bg-white px-4 py-2.5 text-base outline-none focus:border-cyan-500 focus:ring-[3px] focus:ring-cyan-400/30"
                />
                {fieldErrors.email && (
                  <p class="mt-1.5 text-xs font-medium text-red-600" role="alert">
                    {fieldErrors.email}
                  </p>
                )}
              </div>
              <div>
                <label
                  for="sites-gate-reason"
                  class="font-heading text-ink-700 mb-1.5 block text-xs font-semibold tracking-wide uppercase"
                >
                  Reason for Browsing
                </label>
                <input
                  id="sites-gate-reason"
                  name="reason"
                  type="text"
                  required
                  value={submittedValues.reason}
                  aria-invalid={Boolean(fieldErrors.reason)}
                  class="border-steel-300 w-full rounded-lg border bg-white px-4 py-2.5 text-base outline-none focus:border-cyan-500 focus:ring-[3px] focus:ring-cyan-400/30"
                />
                {fieldErrors.reason && (
                  <p class="mt-1.5 text-xs font-medium text-red-600" role="alert">
                    {fieldErrors.reason}
                  </p>
                )}
              </div>
              {gateError && (
                <p class="text-sm font-medium text-red-600" role="alert">
                  {gateError}
                </p>
              )}
              <button
                type="submit"
                class="font-heading text-navy-950 shadow-soft hover:shadow-card flex h-[48px] w-full items-center justify-center rounded-lg bg-cyan-400 text-sm font-semibold tracking-wide uppercase transition-all duration-200 hover:bg-cyan-300"
              >
                View Sites
              </button>
            </form>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
