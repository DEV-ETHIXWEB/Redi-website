---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SetPasswordForm from '@/components/forms/SetPasswordForm';
import Logo from '@/components/ui/Logo.astro';
import { getPageCopy } from '@/services/wordpress';

const copy = await getPageCopy();
const sp = copy.setPassword;

// TODO(auth): this page receives no reset/invite token today. Once the
// backend exists, the emailed link (see forgot-password.astro TODO) should
// arrive as `/set-password?token=<opaque-token>`. Read it here with
// `Astro.url.searchParams.get('token')`, validate its presence (redirect to
// `/forgot-password` or show an "invalid/expired link" state if missing),
// and pass it down as a prop to <SetPasswordForm> so its submit handler can
// include it in the API request — see the TODO block in
// src/components/forms/SetPasswordForm.tsx for the client-side half of this.
---

<BaseLayout
  title="Set Password - REDI Sites"
  description="Set your REDI Sites account password."
  noindex
>
  <section class="bg-steel-100 pt-32 pb-16">
    <div class="container-page">
      <div class="mx-auto max-w-[1040px]">
        <div class="flex flex-col items-center text-center">
          <Logo variant="nav" label="" class="h-[44px] w-[54px]" />
          <h1 class="mt-6 text-4xl sm:text-[2.75rem]">{sp.heading}</h1>
          <p class="text-ink-600 mt-1 text-base">{sp.body}</p>
        </div>

        <div class="mt-10">
          <SetPasswordForm client:load copy={sp} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
