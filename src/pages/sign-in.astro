---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
---

<BaseLayout title="Sign In - REDI Sites" description="Sign in to your REDI Sites account." noindex>
  <section class="bg-steel-100 pt-32 pb-24">
    <div class="container-page">
      <div
        class="bg-steel-200/70 shadow-lifted relative mx-auto max-w-[580px] rounded-3xl px-6 py-8 sm:px-12 sm:py-10"
      >
        <a
          href="/"
          class="text-ink-600 hover:text-ink-900 absolute top-6 right-6 transition-colors sm:top-8 sm:right-8"
          aria-label="Close and return home"
        >
          <Icon name="x" size={22} />
        </a>
        <Logo variant="nav" class="mx-auto" />

        <h1 class="mt-10 text-4xl sm:text-[2.75rem]">Sign In</h1>
        <p class="text-ink-600 mt-1 text-lg">Access your REDI SITES dashboard.</p>

        <!--
          The member portal backend is still being connected; this form routes to contact.

          TODO(auth): wire this up to a real Login API once the backend exists.
          Concretely, when the backend is ready:
            1. Change method="get" action="/contact" to a real submit handler
               (either a client-side fetch to POST /api/auth/login, or an
               Astro API route at src/pages/api/auth/login.ts that proxies to
               WordPress - see docs/WORDPRESS_INTEGRATION.md § Authentication
               Preparation for the recommended shape).
            2. Expected request:  POST /api/auth/login  { email, password, stay }
               (`stay` = the "Stay Logged In" checkbox below - maps to a
               longer-lived session/refresh token vs. a session-only cookie).
            3. Expected response (success): 200 + Set-Cookie (httpOnly session
               cookie) or { token, refreshToken } if using bearer-token auth -
               decide session-cookie vs. token strategy before implementing,
               see docs/WORDPRESS_INTEGRATION.md.
            4. Expected response (failure): 401 with a machine-readable error
               code (e.g. { error: "invalid_credentials" }) so the UI can show
               a specific message rather than a generic "something went wrong".
            5. On success: redirect to the member dashboard (does not exist in
               this build yet - see HANDOFF.md § "not required" / dashboard
               scope) or back to the originating page.
            6. Add a loading state + inline error message UI (see
               SetPasswordForm.tsx for the pattern already used elsewhere in
               this codebase: status state machine + aria-live error region).
            7. Password field currently has no client-side validation at all -
               add the same validation rules used in SetPasswordForm.tsx once
               this becomes a real submit (min length, etc.) for consistent
               UX, though the backend must be the source of truth for auth
               validation, not the client.
        -->
        <form method="get" action="/contact" class="mt-8" data-signin-form>
          <label
            class="font-heading text-ink-900 block text-base font-bold tracking-wide uppercase"
          >
            Email
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              class="font-body text-ink-900 placeholder:text-ink-600/70 mt-2 block h-14 w-full rounded-2xl border-0 bg-white px-6 text-lg font-normal normal-case shadow-sm focus:ring-2 focus:ring-cyan-400 focus:outline-none"
            />
          </label>

          <div class="mt-6 flex items-end justify-between">
            <span class="font-heading text-ink-900 text-base font-bold tracking-wide uppercase">
              Password
            </span>
            <a
              href="/forgot-password"
              class="font-heading hover:text-navy-950 inline-flex items-center gap-1 text-sm font-bold tracking-wide text-cyan-600 uppercase transition-colors"
            >
              Forgot Password?
              <Icon name="chevron-right" size={16} />
            </a>
          </div>
          <div class="relative mt-2">
            <input
              type="password"
              name="password"
              placeholder="••••••••"
              data-password-input
              class="font-body text-ink-900 placeholder:text-ink-600/70 block h-14 w-full rounded-2xl border-0 bg-white px-6 pr-14 text-lg shadow-sm focus:ring-2 focus:ring-cyan-400 focus:outline-none"
            />
            <button
              type="button"
              data-password-toggle
              aria-label="Show password"
              class="text-ink-600 hover:text-ink-900 absolute top-1/2 right-5 -translate-y-1/2 transition-colors"
            >
              <Icon name="eye" size={20} />
            </button>
          </div>

          <label class="text-ink-700 mt-5 flex items-center gap-2.5 text-base">
            <input
              type="checkbox"
              name="stay"
              class="text-ink-900 size-5 rounded border-slate-400 focus:ring-cyan-400"
            />
            Stay Logged In
          </label>

          <button
            type="submit"
            class="font-heading text-navy-950 shadow-soft hover:shadow-card mt-8 block h-[58px] w-full rounded-2xl bg-cyan-400 text-xl font-semibold tracking-wide uppercase transition-all duration-200 hover:-translate-y-0.5 hover:bg-cyan-300"
          >
            Sign In
          </button>
        </form>

        <p class="text-ink-600 mt-6 text-right text-base">
          No Account? -{' '}
          <a
            href="/register"
            class="hover:text-navy-950 text-cyan-600 transition-colors hover:underline"
          >
            Request Access
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initPasswordToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const input = btn.parentElement?.querySelector<HTMLInputElement>('[data-password-input]');
        if (!input) return;
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      });
    });
  }
  initPasswordToggle();
  document.addEventListener('astro:page-load', initPasswordToggle);
</script>
